rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isStringField(fieldName) {
      return request.resource.data[fieldName] is string;
    }

    function isNumberField(fieldName) {
      return request.resource.data[fieldName] is number;
    }

    function isValidOrderCreate() {
      return request.resource.data.keys().hasAll([
          'orderNumber',
          'ordererName',
          'ordererPhone',
          'eventDate',
          'cart',
          'createdAt'
        ])
        && isStringField('orderNumber')
        && isStringField('ordererName')
        && isStringField('ordererPhone')
        && isStringField('eventDate')
        && request.resource.data.cart is map
        && isNumberField('createdAt');
    }

    function isPublicPdfStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pdfDownloadUrl',
          'sheetSynced',
          'sheetSyncError'
        ])
        && (!('pdfDownloadUrl' in request.resource.data) || request.resource.data.pdfDownloadUrl is string)
        && (!('sheetSynced' in request.resource.data) || request.resource.data.sheetSynced is bool)
        && (!('sheetSyncError' in request.resource.data) || request.resource.data.sheetSyncError is string);
    }

    match /orders/{orderId} {
      // Public read is still required by the existing order inquiry flow.
      allow read: if true;
      allow create: if isValidOrderCreate();
      allow update: if isAdmin() || isPublicPdfStatusUpdate();
      allow delete: if isAdmin();
    }

    match /settings/productAvailability {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
